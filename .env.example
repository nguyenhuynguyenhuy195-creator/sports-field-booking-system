FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=sports_field_booking
DB_USERNAME=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Phase 1.3B1: public Nominatim is suitable only for low-volume student/demo use.
# Use an identifying User-Agent, keep geocoding server-side, and change the
# provider/base URL before production-scale traffic. No API secret is required.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=sports-field-booking-student-demo/1.0 (https://github.com/nguyenhuynguyenhuy195-creator/sports-field-booking-system)
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_CACHE_TTL_SECONDS=86400

# OSM-compatible browser tiles are independent from the geocoding service.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Payment providers:
# MOCK        = always-on fallback for dev/test; no external network calls.
# VNPAY       = real Sandbox provider once VNPAY_ENABLED=true and the
#               credentials below are filled in from your own VNPAY
#               merchant sandbox account. Never commit real values here.
# MoMo        = legacy, permanently disabled at the code level
#               (MOMO_ENABLED is hardcoded false in config.py regardless of
#               this file); the keys below only document the old
#               integration and are not honored by the running app.
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=https://your-public-domain.example/payments/momo/return
MOMO_IPN_URL=https://your-public-domain.example/payments/momo/ipn
MOMO_TIMEOUT_SECONDS=30

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://your-public-domain.example/payments/vnpay/return
VNPAY_IPN_URL=https://your-public-domain.example/payments/vnpay/ipn
VNPAY_TIMEOUT_SECONDS=30
VNPAY_VERSION=2.1.0
VNPAY_LOCALE=vn
# Non-secret defaults used only when submitting a VNPAY refund request.
VNPAY_REFUND_CREATE_BY=system
VNPAY_REFUND_IP_ADDR=127.0.0.1
