FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=sports_field_booking
DB_USERNAME=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Browser key only. Restrict it by HTTP referrer and enable only
# Maps JavaScript API + Places API (New) in Google Cloud Console.

# MoMo Sandbox. Keep disabled until you have M4B test credentials and a
# public HTTPS tunnel/domain for the return and server-to-server IPN URLs.
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=https://your-public-domain.example/payments/momo/return
MOMO_IPN_URL=https://your-public-domain.example/payments/momo/ipn
MOMO_TIMEOUT_SECONDS=30
